<%# Form for adding a new inventory classification %>
<div class="form-container">
    <h1>Add New Classification</h1>

    <% if (message && message.length> 0) { %>
        <div class="notice">
            <%= message[0] %>
        </div>
        <% } %>

            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <p>Classification name cannot contain spaces or special characters.</p>

                    <form action="/inv/add-classification" method="post" novalidate>
                        <label for="classification_name">Classification Name</label>
                        <input type="text" id="classification_name" name="classification_name" required
                            pattern="^[A-Za-z0-9]+$" placeholder="Enter Classification Name" value="<%= classification_name %>">
                        <button type="submit">Add Classification</button>
                    </form>
</div>