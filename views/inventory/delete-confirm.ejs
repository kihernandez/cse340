<%# Inventory Delete Confirmation View %>
<div class="form-container">
    <h1><%= title %></h1>

    <% if (message && message.length > 0) { %>
        <div class="notice">
            <%= message[0] %>
        </div>
    <% } %>

    <% if (errors) { %>
        <ul class="notice">
            <% errors.array().forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <p>Confirm Deletion - This action is permanent and cannot be undone.</p>

    <form action="/inv/delete" method="post" novalidate>

        <label for="inv_make">Make</label>
        <input 
            type="text" 
            id="inv_make" 
            name="inv_make"
            value="<%= inv_make %>"
            readonly
        >

        <label for="inv_model">Model</label>
        <input 
            type="text" 
            id="inv_model" 
            name="inv_model"
            value="<%= inv_model %>"
            readonly
        >

        <label for="inv_year">Year</label>
        <input 
            type="number" 
            id="inv_year" 
            name="inv_year"
            value="<%= inv_year %>"
            readonly
        >

        <label for="inv_price">Price</label>
        <input 
            type="number" 
            id="inv_price" 
            name="inv_price"
            value="<%= inv_price %>"
            readonly
        >

        <!-- Hidden ID -->
        <input type="hidden" name="inv_id" value="<%= inv_id %>">

        <button type="submit">Delete Vehicle</button>

    </form>
</div>
