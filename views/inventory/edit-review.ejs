<%# Edit Review Page %>
<%- include('../partials/header') %>

<main id="wrapper">
  <h1>Edit Your Review</h1>

  <% if (message && message.length > 0) { %>
    <div class="notice"><%= message[0] %></div>
  <% } %>

  <form action="/inv/review/update" method="post" id="editReviewForm">

    <label for="rating">Rating (1–5)</label>
    <select id="rating" name="rating" required>
      <option value="">Select rating</option>
      <option value="1" <%= review.rating == 1 ? "selected" : "" %>>1 - Poor</option>
      <option value="2" <%= review.rating == 2 ? "selected" : "" %>>2 - Fair</option>
      <option value="3" <%= review.rating == 3 ? "selected" : "" %>>3 - Good</option>
      <option value="4" <%= review.rating == 4 ? "selected" : "" %>>4 - Very Good</option>
      <option value="5" <%= review.rating == 5 ? "selected" : "" %>>5 - Excellent</option>
    </select>

    <label for="review_text">Your Review</label>
    <textarea
      id="review_text"
      name="review_text"
      required
      minlength="5"
    ><%= review.review_text %></textarea>

    <!-- Hidden fields -->
    <input type="hidden" name="review_id" value="<%= review.review_id %>">
    <input type="hidden" name="inv_id" value="<%= review.inv_id %>">

    <button type="submit">Save Changes</button>
  </form>
</main>
