<%# Partials - Header %>
<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">CSE Motors</a>
  </span>

  <div id="tools">
    <% if (!locals.accountData) { %>
      <!-- User NOT logged in -->
      <a title="Click to log in" href="/account/login">My Account</a>
    <% } else { %>
      <!-- User IS logged in -->
      <a href="/account/" title="Go to account management">
        Welcome <%= locals.accountData.account_firstname %>
      </a>
      <a href="/account/logout" title="Click to logout">Logout</a>
    <% } %>
  </div>
</header>
